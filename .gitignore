# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le gabarit ne contient que des placeholders : c'est lui qui fait foi sur les
# variables attendues (une var absente d'ici finit par manquer en production).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
