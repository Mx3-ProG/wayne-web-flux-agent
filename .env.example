# Supabase (projet dédié à wayne-web-flux — ne pas réutiliser celui de wayne-web-site)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# API Claude (génération IA)
ANTHROPIC_API_KEY=sk-ant-xxx

# URL publique de l'app (liens dans les emails, iCal…)
NEXT_PUBLIC_SITE_URL=https://www.flux-wayne.com

# Administration interne. Utiliser une valeur aléatoire d'au moins 24 caractères ;
# le dashboard sera disponible exactement à https://votre-domaine/<cette-valeur>.
ADMIN_ENTRY_KEY=remplacer-par-une-valeur-aleatoire-longue
# Secret Vercel Cron utilisé pour la purge automatique des journaux 13/36 mois.
CRON_SECRET=remplacer-par-un-secret-aleatoire-distinct

# Resend (emails transactionnels + SMTP Supabase Auth) — facultatif en dev
# Voir supabase/email-templates/README.md pour la configuration complète.
RESEND_API_KEY=re_xxx
# Expéditeur (domaine vérifié dans Resend). Sans cette var : fallback dev
# onboarding@resend.dev (n'envoie qu'à l'adresse du compte Resend).
EMAIL_FROM=FLUX <no-reply@mail.votre-domaine.fr>

# Boîte où atterrissent les réponses aux emails de compte/sécurité (l'adresse
# d'envoi noreply@ ne reçoit rien). Doit être une adresse réellement relevée.
EMAIL_REPLY_TO=contact@votre-domaine.fr

# Boîte qui reçoit les messages du formulaire « Contacte-nous » de la page
# d'accueil. Sans cette variable, ils partent vers le repli codé en dur
# (contact@wayne-web.com) — silencieusement, sans aucune alerte.
CONTACT_EMAIL=contact@votre-domaine.fr

# Assistante FLUX sur les surfaces marketing. Mettre à "true" pour la masquer
# (démo, capture d'écran, incident). Absente = assistante active.
NEXT_PUBLIC_FLUX_ASSISTANT_DISABLED=

# Stripe Custom Checkout + Payment Element + Billing. Créer quatre Prices mensuels en EUR dans Stripe,
# puis recopier leurs identifiants price_... ici.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Alias historique accepté en repli si NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY est
# absente (pages /checkout). Poser l'une OU l'autre, pas les deux.
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIQUE=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_ENTREPRISE=price_xxx
STRIPE_PRICE_CREDITS_PACK50=price_xxx
STRIPE_PRICE_CREDITS_PACK150=price_xxx
STRIPE_PRICE_CREDITS_PACK400=price_xxx
# true uniquement après configuration des immatriculations dans Stripe Tax.
STRIPE_AUTOMATIC_TAX=false

# Identité légale affichée dans les pages publiques et les liens de Checkout.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Votre raison sociale
NEXT_PUBLIC_COMPANY_LEGAL_FORM=SAS / SARL / EI
NEXT_PUBLIC_COMPANY_ADDRESS=Adresse complète
NEXT_PUBLIC_COMPANY_SIRET=000 000 000 00000
NEXT_PUBLIC_COMPANY_VAT=FR00000000000
NEXT_PUBLIC_BILLING_EMAIL=facturation@votre-domaine.fr
NEXT_PUBLIC_HOST_NAME=Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis

# Notifications Push (Web Push / VAPID). Sans ces trois variables la souscription
# échoue silencieusement côté navigateur et le cron /api/cron/push-deliveries
# tourne à vide. Générer la paire de clés avec :
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY est la seule exposée au client (pour souscrire) ;
# VAPID_PRIVATE_KEY ne doit jamais l'être.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# --- Google Ads (balise gtag.js) ---
# Identifiant de la balise Google (format AW-XXXXXXXXXX). Facultatif : la
# valeur du compte est codée en dur dans lib/analytics/google-tag.ts, cette
# variable ne sert qu'à la surcharger (autre compte, environnement de test).
NEXT_PUBLIC_GOOGLE_ADS_ID=

# --- Développement local uniquement (ne JAMAIS poser en production) ---
# Compte admin de test provisionné à la volée au premier signIn, et seulement
# si NODE_ENV=development (voir app/login/actions.ts). Sans ces deux variables,
# rien n'est provisionné.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# Comptes de test créés par `npm run seed:test-accounts`. Valeurs par défaut :
# wayne-web.test / Flux-Test-2026!
TEST_ACCOUNT_DOMAIN=
TEST_ACCOUNT_PASSWORD=
